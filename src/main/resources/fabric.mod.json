{
  "schemaVersion": 1,
  "id": "liquidbounce",
  "version": "${version}",
  "name": "Baribounce",
  "description": "An unofficial fork of LiquidBounce with a redesigned ClickGUI, config switcher and Baritone integration. Not affiliated with or endorsed by CCBlueX.",
  "authors": [
    "CCBlueX"
  ],
  "contributors": $contributors,
  "contact": {
    "sources": "https://github.com/CCBlueX/LiquidBounce/"
  },
  "license": "GNU General Public License v3.0",
  "icon": "resources/liquidbounce/icon_64x64.png",
  "environment": "client",
  "entrypoints": {
    "main": []
  },
  "custom": {
    "liquidbounce": {
      "edition": "${edition}"
    }
  },
  "mixins": [
    "liquidbounce.mixins.json"
  ],
  "depends": {
    "minecraft": ["${minecraft_version}"],
    "fabricloader": ">=${min_loader_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}"
  },
  "suggests": {
    "fabric": ">=${fabric_version}",
    "viafabricplus": ">=${viafabricplus_version}"
  },
  "breaks": {
    "viafabricplus": "<${viafabricplus_version}"
  },
  "accessWidener": "liquidbounce.accesswidener"
}
